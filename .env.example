# Example environment file — safe to commit.
#
# Copy this file to `.env` (which is git-ignored) and fill in real values
# locally. NEVER put real secrets in this file or commit a populated `.env`.
# Document every variable your tool needs here, with a non-secret placeholder,
# so another team can reproduce your setup.

# --- Examples (delete or replace with your own) -------------------------------

# Base URL for an external data API your tool calls.
DATA_API_BASE_URL=https://example.org/api

# API key for a third-party service. Leave blank here; set the real value in .env.
DATA_API_KEY=

# Directory where the tool reads/writes local data.
DATA_DIR=./data
